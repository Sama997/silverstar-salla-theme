<article class="ss-product-card ss-reveal">
  <a class="ss-product-card__image" href="{{ url }}">
    <img src="{{ image|asset }}" alt="{{ title }}" loading="lazy">
  </a>
  <div class="ss-product-card__body">
    <p class="ss-product-card__spec">{{ spec }}</p>
    <h3><a href="{{ url }}">{{ title }}</a></h3>
    <div class="ss-product-card__footer">
      <a class="ss-button ss-button--compact" href="{{ url }}">عرض المنتج</a>
    </div>
  </div>
</article>
