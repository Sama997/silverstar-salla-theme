{% extends "layouts.master" %}

{% block title %}{{ product.name|default('منتج سيلفر ستار') }} | سيلفر ستار{% endblock %}
{% set seo_description = product.subtitle|default(product.description|default('مكنسة سيلفر ستار للجاف والرطب بقوة شفط عالية وتجربة مناسبة للأرضيات الصلبة والسيراميك.'))|striptags|slice(0, 155) %}
{% set seo_image = product.image.url|default(product.image|default('images/vacuum-pro.png'|asset)) %}
{% block seo %}
  <meta name="description" content="{{ seo_description|trim|e('html_attr') }}">
  <meta property="og:type" content="product">
  <meta property="og:title" content="{{ (product.name|default('منتج سيلفر ستار') ~ ' | سيلفر ستار')|e('html_attr') }}">
  <meta property="og:description" content="{{ seo_description|trim|e('html_attr') }}">
  <meta property="og:image" content="{{ seo_image|e('html_attr') }}">
{% endblock %}

{% block content %}
  {% component breadcrumbs %}

  {% set images = product.images|default([]) %}
  {% set main_image = product.image.url|default(product.image|default('images/vacuum-pro.png'|asset)) %}

  <article class="ss-pdp" data-ss-product-page data-product-id="{{ product.id|default('') }}">
    <section class="ss-pdp__gallery" aria-label="صور المنتج">
      <div class="ss-pdp__main-image">
        <img src="{{ main_image }}" alt="{{ product.name|default('مكنسة سيلفر ستار') }}" fetchpriority="high">
      </div>

      {% if images|length %}
        <div class="ss-pdp__thumbs">
          {% for image in images|slice(0, 6) %}
            <button type="button" data-ss-thumb="{{ image.url|default(image) }}" aria-label="عرض صورة {{ loop.index }}">
              <img src="{{ image.url|default(image) }}" alt="" loading="lazy">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </section>

    <section class="ss-pdp__summary">
      {% if product.brand.name is defined %}
        <p class="ss-kicker">{{ product.brand.name }}</p>
      {% else %}
        <p class="ss-kicker">سيلفر ستار</p>
      {% endif %}

      <h1>{{ product.name|default('مكنسة سيلفر ستار للجاف والرطب') }}</h1>

      {% if product.subtitle is defined %}
        <p class="ss-pdp__subtitle">{{ product.subtitle }}</p>
      {% else %}
        <p class="ss-pdp__subtitle">تنظيف جاف ورطب مع قوة شفط عالية وتجربة مناسبة للأرضيات الصلبة والسيراميك.</p>
      {% endif %}

      <div class="ss-pdp__rating">
        <salla-rating-stars value="{{ product.rating.stars|default(product.rating)|default(5) }}"></salla-rating-stars>
        <span>تجربة شراء موثوقة</span>
      </div>

      <div class="ss-pdp__price">
        {% if product.is_on_sale|default(false) %}
          <strong>{{ product.sale_price|money }}</strong>
          <del>{{ product.regular_price|money }}</del>
        {% elseif product.price is defined %}
          <strong>{{ product.price|money }}</strong>
        {% endif %}
      </div>

      <div class="ss-pdp__trust">
        <span>ضمان وخدمة ما بعد البيع</span>
        <span>دفع مرن</span>
        <span>شحن داخل المملكة</span>
      </div>

      <div class="ss-pdp__buy-box">
        {% hook 'product:single.form.start' %}
        <salla-product-options class="ss-pdp__options" product-id="{{ product.id|default('') }}"></salla-product-options>

        <div class="ss-pdp__quantity">
          <label for="ss-product-quantity">الكمية</label>
          <salla-quantity-input id="ss-product-quantity" name="quantity" value="1" min="1"></salla-quantity-input>
        </div>

        {% if product.id is defined %}
          <salla-add-product class="ss-pdp-primary-action" product-id="{{ product.id }}">أضف للسلة الآن</salla-add-product>
        {% else %}
          <a class="ss-button ss-button--primary" href="/search?q=سيلفر%20ستار">عرض المنتجات</a>
        {% endif %}
        {% hook 'product:single.form.end' %}
      </div>
    </section>
  </article>

  {% include 'components/silverstar/specs-table.twig' with { product: product } %}

  <section class="ss-section ss-pdp-details" aria-labelledby="ss-details-title">
    <div class="ss-section__head ss-section__head--compact">
      <p class="ss-kicker">تفاصيل الاستخدام</p>
      <h2 id="ss-details-title">مصممة لتنظيف عملي بلا تعقيد</h2>
    </div>
    <div class="ss-rich-content">
      {% hook 'product:single.description.start' %}
      {{ product.description|default('مكنسة سيلفر ستار مناسبة للتنظيف الجاف والرطب، وتساعد في سحب الماء من السيراميك والأرضيات الصلبة مع ملحقات متعددة للاستخدام اليومي.')|raw }}
      {% hook 'product:single.description' %}
    </div>
  </section>

  <section class="ss-section ss-proof ss-proof--pdp" aria-labelledby="ss-pdp-proof-title">
    <div class="ss-proof__copy">
      <p class="ss-kicker">قبل الشراء</p>
      <h2 id="ss-pdp-proof-title">شاهد أداء التجفيف</h2>
      <p>الفيديو القصير يساعد العميل على فهم فرق الجاف والرطب وتجفيف السيراميك قبل إضافة المنتج للسلة.</p>
    </div>
    <figure class="ss-proof__media">
      <video controls preload="metadata" poster="{{ 'images/ceramic-drying-banner.png'|asset }}">
        <source src="{{ 'videos/ceramic-dry-demo.mp4'|asset }}" type="video/mp4">
        المتصفح لا يدعم تشغيل الفيديو.
      </video>
    </figure>
  </section>

  {% component comments %}
  {% component product.similar-products %}

  {% set sticky_add_to_cart_enabled = theme.settings.sticky_add_to_cart ?? true %}
  {% if sticky_add_to_cart_enabled %}
    <div class="ss-sticky-buy" data-ss-sticky-buy hidden>
      <div>
        <strong>{{ product.name|default('مكنسة سيلفر ستار') }}</strong>
        {% if product.price is defined %}
          <span>{{ product.price|money }}</span>
        {% endif %}
      </div>
      <button class="ss-button ss-button--primary" type="button" data-ss-sticky-add>أضف للسلة</button>
    </div>
  {% endif %}
{% endblock %}
